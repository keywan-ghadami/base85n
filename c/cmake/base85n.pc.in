prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: base85n
Description: Base85N: a compact encoding for data embedded in text formats
URL: https://github.com/keywan-ghadami/base85n
Version: @PROJECT_VERSION@
Cflags: -I${includedir}
Libs: -L${libdir} -lbase85n
