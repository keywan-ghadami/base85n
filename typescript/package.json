{
  "name": "base85n",
  "version": "0.1.0",
  "description": "Base85N binary-to-text encoding scheme (core Base85 block mode + Dynamic Passthrough mode)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "base85",
    "encoding",
    "binary-to-text"
  ],
  "license": "MPL-2.0",
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
