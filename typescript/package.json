{
  "name": "base85n",
  "version": "0.5.0",
  "description": "Base85N: a compact encoding for data embedded in text formats (JSON, XML, HTML, config), with Dynamic Passthrough and Fill modes",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "base85",
    "base64-alternative",
    "encoding",
    "embedding",
    "json",
    "binary-to-text"
  ],
  "license": "MPL-2.0",
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
